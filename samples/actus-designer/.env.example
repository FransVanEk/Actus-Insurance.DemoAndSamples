# ─── Public (exposed to browser) ─────────────────────────────────────────────
# Base URL used by SWR / client fetcher.
# In development this hits the Next.js proxy routes (/api/...).
# In production point this at your own domain or keep it as /api to keep using the proxy.
NEXT_PUBLIC_API_URL=

# ─── Server-only (never sent to the browser) ─────────────────────────────────
# Real ACTUS backend base URL — used only inside Next.js API route handlers.
API_BASE_URL=http://localhost:8080

# API key / Bearer token for the ACTUS backend.
API_KEY=your-api-key-here

# Optional: Basic-auth credentials (used if the backend requires them instead of a token).
API_USERNAME=
API_PASSWORD=

# Optional: Tenant / organisation identifier required by some ACTUS deployments.
API_TENANT_ID=
