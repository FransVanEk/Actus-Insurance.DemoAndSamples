# ─── Public (exposed to browser) ─────────────────────────────────────────────
# Leave empty to use the built-in Next.js proxy (/api/...).
# Set to a full URL (e.g. https://api.actus.example.com) to skip the proxy.
NEXT_PUBLIC_API_URL=

# ─── Server-only (never sent to the browser) ─────────────────────────────────
API_BASE_URL=https://localhost:5001
NEXT_PUBLIC_API_BASE_URL=https://localhost:5001
API_KEY=dev-api-key-change-me
API_USERNAME=
API_PASSWORD=
API_TENANT_ID=

# ─── Dev only — allow self-signed TLS cert on localhost ──────────────────────
NODE_TLS_REJECT_UNAUTHORIZED=0
