# Environment variables for Docker Compose

# API Configuration
API_PORT=8080
PREFER_GPU=false

# Frontend Configuration
FRONTEND_PORT=3000

# ACTUS Designer API Connection
# Leave NEXT_PUBLIC_API_URL empty to use Next.js proxy (/api/...)
# Set to full URL (e.g. http://localhost:8080) to bypass proxy
NEXT_PUBLIC_API_URL=

# API Authentication
API_KEY=dev-api-key-change-me
API_USERNAME=
API_PASSWORD=
API_TENANT_ID=

# Development settings
NODE_ENV=production